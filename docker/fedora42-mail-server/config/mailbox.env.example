# Example environment overrides for the codex-mail-server container.
# Copy this file to a writable mount (e.g. /config/mailbox.env) and set
# CODEX_MAIL_SERVER_ENV_FILE=/config/mailbox.env to apply overrides.

# Namespace used for socket/registry layout under $CODEX_HOME/<namespace>.
# CODEX_NAMESPACE=codex

# Delivery backend: 'unix' for single-node or 'nats' for broker fan-out.
# CODEX_MAIL_SERVER_DELIVERY_BACKEND=nats

# When using the broker backend, provide the target NATS endpoint and token.
# CODEX_MAIL_SERVER_BROKER_URL=nats://nats:4222
# CODEX_MAIL_SERVER_BROKER_TOKEN=supersecret
# CODEX_MAIL_SERVER_BROKER_SUBJECT_PREFIX=codex.mail

# Path overrides (defaults are derived from CODEX_HOME and CODEX_NAMESPACE).
# CODEX_MAIL_SERVER_SOCKET=/var/run/codex-mailbox/codex/mailbox/dispatcher.sock
# CODEX_MAILBOX_REGISTRY_PATH=/var/run/codex-mailbox/codex/mailbox/registry.json

# Logging: send structured output to stdout/stderr and optionally to a file.
# CODEX_MAIL_SERVER_LOG_FILE=/var/log/codex-mailbox/codex-mail-server.log
